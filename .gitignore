# ============================================================
#  qqbot-multiple-character .gitignore
# ============================================================

# ── 运行时 / 构建产物 ──────────────────────────────────────
# Python 虚拟环境（setup.bat 创建）
skill_qqbot/

# 第三方程序（SnowLuma 让用户手动下载到 snowluma/）
snowluma/

# 运行时 PID / 临时目录
.runtime/
*.pid

# 日志目录（顶层 + 子模块）
logs/
!logs/.gitkeep
qqbot/logs/
!qqbot/logs/.gitkeep
*.log

# 运行时持久化数据（bot 自己生成）
qqbot/data/
!qqbot/data/.gitkeep

# ── 隐私 / 敏感配置（绝不能进仓库） ─────────────────────────
# 真实 API Key / Cookie / 对话历史 / 用户画像
private/
!private/.gitkeep
!private/.env.example

# ── Python 缓存 ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/

# ── IDE / 编辑器 ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ── OS 临时文件 ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── 临时 / 备份 ──────────────────────────────────────────
*.tmp
*.bak
*.swp
*.orig
*.rej

# ── 用户自填内容（保留示例角色头像目录结构但忽略实际内容） ──────────────
# 角色头像目录（每个角色一个子目录，放 avatar.jpg/png）
photo/*
!photo/.gitkeep
!photo/makise-kurisu/
!photo/makise-kurisu/.gitkeep
!photo/makise-kurisu/avatar.*

# 表情图片目录（10 个情绪子目录，已含 keywords.txt）
emoji/*/1.*
emoji/*/2.*
emoji/*/3.*
emoji/*/*.gif
emoji/*/*.jpg
emoji/*/*.png

# ── 兜底 ─────────────────────────────────────────────────
# 任何 .env 文件（防止私钥漏出）
.env
.env.*
!.env.example

# SnowLuma 反向 WS 运行时真值配置（模板 .example.json 入库）
qqbot/snowluma_onebot_config.json