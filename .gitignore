# ============================================================
#  qqbot-multiple-character .gitignore（本地版）
#  基础沿用公开仓库 origin/master 的规则，并额外排除本地私有内容。
#  原则：代码 / 文档 / 模板进仓库；密钥、角色、语料、运行时数据、
#        第三方运行时（SnowLuma）与历史归档一律本地保留。
# ============================================================

# ── 本地私有内容（不出现在公开仓库） ───────────────────────
# 圈子共享背景 + 真人分析，仅本地
normal-paper/
# 全部角色（含真人系），仅本地
qqbot/characters/
private/
corpus/
photo/
archive/
skill/
.work/
.pids/
.runtime/

# ── 运行时 / 构建产物 ─────────────────────────────────────
qqbot/logs/
qqbot/data/
logs/
skill_qqbot/
snowluma/
*.pid
*.log

# ── 隐私 / 敏感配置（绝不能进仓库） ───────────────────────
.env
.env.*
!.env.example
qqbot/.env
# 真值配置（只提交 .example.json 模板）
qqbot/snowluma_onebot_config.json

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/

# ── IDE / 编辑器 ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS 临时文件 ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── 临时 / 备份 ──────────────────────────────────────────
*.tmp
*.bak
*.bak_*
*.orig
*.rej
.tmp_helper_marker.txt
._*

# ── 表情图片（体积大，本地保留；仓库只提交 keywords.txt 结构） ──
emoji/*/*.gif
emoji/*/*.jpg
emoji/*/*.jpeg
emoji/*/*.png
emoji/*/*.webp
