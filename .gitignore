# ============================================================
#  qqbot-multiple-character .gitignore
#  原则：代码 / 文档 / 示例进仓库；密钥、真实角色、语料、运行时数据、
#        第三方运行时（SnowLuma）与历史归档一律只留本地。
# ============================================================

# ── 本地私有内容（不出现在公开仓库） ───────────────────────
private/
corpus/
photo/
archive/
skill/
.work/
.pids/
.runtime/

# ── 角色：只公开 2 个 anime 示例角色 + 目录说明 ─────────────
qqbot/characters/*
!qqbot/characters/README.md
!qqbot/characters/makise-kurisu/
!qqbot/characters/amadeus-kurisu/

# ── 共享背景：只公开 README + examples 示例 ─────────────────
normal-paper/*
!normal-paper/README.md
!normal-paper/examples/

# ── 运行时 / 构建产物 ─────────────────────────────────────
qqbot/logs/
qqbot/data/
logs/
skill_qqbot/
snowluma/
*.pid
*.log

# ── 隐私 / 敏感配置（绝不能进仓库） ───────────────────────
.env
.env.*
!.env.example
qqbot/.env
# 真值配置（只提交 .example.json 模板）
qqbot/snowluma_onebot_config.json

# ── 不要进公开库的截图 / 图片 ───────────────────────────────
# 旧版 Dashboard 截图（含 NapCat 时代界面，已过时）
docs/dashboard.png
# QQ 群二维码（含群号）
assets/images/qq_women_de.jpg

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/

# ── IDE / 编辑器 ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS 临时文件 ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── 临时 / 备份 ──────────────────────────────────────────
*.tmp
*.bak
*.bak_*
*.orig
*.rej
.tmp_helper_marker.txt
._*
# Dashboard 热重载触发文件（运行时生成，不入库）
.reload_skills_trigger
.reload_settings_trigger

# ── 表情图片（体积大，本地保留；仓库只提交 keywords.txt 结构） ──
emoji/*/*.gif
emoji/*/*.jpg
emoji/*/*.jpeg
emoji/*/*.png
emoji/*/*.webp

# 临时诊断脚本（开发期排查用，不进公开仓库）
qqbot/_diag_*.py
