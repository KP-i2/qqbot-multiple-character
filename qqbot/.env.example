HOST=0.0.0.0
PORT=8080                               # NoneBot2 监听端口（SnowLuma 通过反向 WS 连到此端口）
COMMAND_START=["/"]
COMMAND_SEP=[" "]
SUPERUSERS=[]

# ============================================================
#  主对话 Provider（必填，当前默认 DeepSeek）
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ============================================================
#  视觉 Provider（识图三选一，默认 deepseek-vision）
# ============================================================
# --- 方案 A（默认）：DeepSeek 官方多模态，复用上面的 DEEPSEEK_API_KEY / BASE_URL ---
DEEPSEEK_VISION_ENABLED=true
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# --- 方案 B（可选）：SiliconFlow 硅基流动 ---
SILICONFLOW_ENABLED=false
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-9B

# --- 方案 C（备用）：MiniMax ---
MINIMAX_ENABLED=false
MINIMAX_API_KEY=sk-cp-your-minimax-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_FAST_MODEL=MiniMax-M2.7-highspeed

# ============================================================
#  Bot 身份与权限
# ============================================================
ADMIN_QQ=your-qq-number
DASHBOARD_TOKEN=your-dashboard-token

# 默认角色 Skill（启动时加载，目录名，即 qqbot/characters/ 下的目录）
DEFAULT_SKILL=makise-kurisu
# 主选对话 Provider（deepseek / minimax，推荐 deepseek）
ACTIVE_LLM_PROVIDER=deepseek

# ============================================================
#  其他
# ============================================================
# Bot 活跃时间（小时，0-23）
ACTIVE_HOURS_START=0
ACTIVE_HOURS_END=23

# Web Search（联网搜索开关）
WEB_SEARCH_ENABLED=true

# 推特抓取登录信息（可选，否则用 Dashboard 上传 Cookie）
# TWITTER_USERNAME=your-x-account
# TWITTER_PASSWORD=your-password
# TWITTER_EMAIL=your-email

# ── 运行时参数（也可通过 Dashboard「参数设置」动态调整） ──
# STREAM_ENABLED=true              # 流式输出开关
# STREAM_FLUSH_CHARS=60            # 流式累积字符数阈值
# STREAM_FLUSH_INTERVAL=8.0        # 流式发送间隔（秒）
# STREAM_FLUSH_MIN_CHARS=80        # 最小累积字符数
# STREAM_MAX_FLUSH_SIZE=300        # 单次最大发送字符数
# MAX_HISTORY_ROUNDS=100           # 最大对话轮数
# HISTORY_TTL_HOURS=36             # 对话历史过期时间（小时）
# HISTORY_SAVE_INTERVAL=60         # 历史持久化间隔（秒）
# THINKING_TIMER_SECONDS=120       # "思考中"提示延迟（秒）
# MULTI_TURN_ENABLED=true          # 多轮对话开关
# IMAGE_HANDLER_ENABLED=true       # 多模态识图总开关
# LLM_TEMPERATURE=0.95             # 采样温度
# LLM_TOP_P=0.9                    # 核采样
# LLM_MAX_TOKENS=16384             # 单次最大输出 tokens
